<Application
  x:Class="Trevunix.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:Trevunix.Converters"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnMainWindowClose"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Views/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BytesConverter x:Key="Bytes" />
      <conv:VisibleWhenConverter x:Key="VisibleWhen" />
      <conv:PercentConverter x:Key="Percent" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
