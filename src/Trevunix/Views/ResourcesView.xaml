<UserControl
  x:Class="Trevunix.Views.ResourcesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:Trevunix.Views"
  xmlns:vm="clr-namespace:Trevunix.ViewModels"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
>
  <UserControl.Resources>
    <!-- One process row with its actions, shared by the CPU and GPU sections. -->
    <DataTemplate x:Key="ResourceRow" DataType="{x:Type vm:ResourceRow}">
      <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
            <ui:SymbolIcon
              FontSize="18"
              Symbol="Apps24"
              Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
            />
            <Image
              RenderOptions.BitmapScalingMode="HighQuality"
              Source="{Binding Icon}"
              Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}}"
            />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}"
              />
              <Border
                Margin="8,0,0,0"
                Padding="6,1"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                CornerRadius="4"
                Visibility="{Binding IsLowered, Converter={StaticResource VisibleWhen}}"
              >
                <TextBlock
                  FontSize="11"
                  Foreground="{DynamicResource SystemFillColorCautionBrush}"
                  Text="{l:T Resources.LoweredBadge}"
                />
              </Border>
              <Border
                Margin="8,0,0,0"
                Padding="6,1"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsProtected, Converter={StaticResource VisibleWhen}}"
              >
                <TextBlock
                  FontSize="11"
                  Style="{StaticResource Muted}"
                  Text="{l:T Resources.System}"
                />
              </Border>
            </StackPanel>
            <TextBlock FontSize="11" Style="{StaticResource Muted}" Text="{Binding Path}" />
          </StackPanel>
          <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding Usage}"
            TextAlignment="Right"
          />
          <TextBlock
            Grid.Column="3"
            VerticalAlignment="Center"
            Style="{StaticResource Muted}"
            Text="{Binding Memory, Converter={StaticResource Bytes}}"
            TextAlignment="Right"
          />
          <StackPanel
            Grid.Column="4"
            Margin="16,0,0,0"
            Orientation="Horizontal"
            Visibility="{Binding CanAct, Converter={StaticResource VisibleWhen}}"
          >
            <ui:Button
              Command="{Binding DataContext.LowerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"
              Icon="{ui:SymbolIcon ArrowDown24}"
              ToolTip="{l:T Resources.Lower}"
              Visibility="{Binding CanLower, Converter={StaticResource VisibleWhen}}"
            />
            <ui:Button
              Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"
              Icon="{ui:SymbolIcon ArrowUndo24}"
              ToolTip="{l:T Resources.Restore}"
              Visibility="{Binding IsLowered, Converter={StaticResource VisibleWhen}}"
            />
            <ui:Button
              Margin="6,0,0,0"
              Appearance="Danger"
              Command="{Binding DataContext.EndCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"
              Icon="{ui:SymbolIcon Dismiss24}"
              ToolTip="{l:T Processes.End}"
            />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
      <views:MemoryView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CpuFreeViewModel}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Border Style="{StaticResource Panel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                MinWidth="110"
                VerticalAlignment="Center"
                FontSize="40"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding CpuText}"
              />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Text="{Binding CpuName}"
                  TextTrimming="CharacterEllipsis"
                />
                <ProgressBar
                  Margin="0,8"
                  Style="{StaticResource UsageBar}"
                  Value="{Binding CpuPercent, Mode=OneWay}"
                />
                <TextBlock Style="{StaticResource Muted}" Text="{l:T Resources.Cpu.Hint}" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <ui:Button
                  HorizontalAlignment="Stretch"
                  Appearance="Primary"
                  Command="{Binding FreeCommand}"
                  Content="{l:T Resources.Cpu.Free}"
                  Icon="{ui:SymbolIcon Flash24}"
                />
                <ui:Button
                  Margin="0,6,0,0"
                  HorizontalAlignment="Stretch"
                  Command="{Binding RestoreAllCommand}"
                  Content="{l:T Resources.RestoreAll}"
                  Icon="{ui:SymbolIcon ArrowUndo24}"
                />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock
            Margin="2,8,0,0"
            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
            Text="{Binding Status}"
            TextWrapping="Wrap"
            Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}"
          />
          <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Resources.Cpu.Top}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemTemplate="{StaticResource ResourceRow}" ItemsSource="{Binding Rows}" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GpuFreeViewModel}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="True"
            Message="{l:T Resources.Gpu.Unsupported}"
            Severity="Warning"
            Visibility="{Binding IsSupported, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
          />
          <Border Style="{StaticResource Panel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                MinWidth="110"
                VerticalAlignment="Center"
                FontSize="40"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding GpuText}"
              />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Text="{Binding GpuName}"
                  TextTrimming="CharacterEllipsis"
                />
                <ProgressBar
                  Margin="0,8,0,4"
                  Style="{StaticResource UsageBar}"
                  Value="{Binding GpuPercent, Mode=OneWay}"
                />
                <DockPanel Margin="0,6,0,0">
                  <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource Muted}"
                    Text="{l:T Resources.Gpu.Vram}"
                  />
                  <TextBlock
                    Margin="8,0,0,0"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding MemoryText}"
                  />
                </DockPanel>
                <ProgressBar
                  Margin="0,6,0,0"
                  Style="{StaticResource UsageBar}"
                  Value="{Binding MemoryPercent, Mode=OneWay}"
                />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <ui:Button
                  HorizontalAlignment="Stretch"
                  Appearance="Primary"
                  Command="{Binding FreeCommand}"
                  Content="{l:T Resources.Gpu.Free}"
                  Icon="{ui:SymbolIcon Flash24}"
                />
                <ui:Button
                  Margin="0,6,0,0"
                  HorizontalAlignment="Stretch"
                  Command="{Binding RestoreAllCommand}"
                  Content="{l:T Resources.RestoreAll}"
                  Icon="{ui:SymbolIcon ArrowUndo24}"
                />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock
            Margin="2,8,0,0"
            Style="{StaticResource Muted}"
            Text="{l:T Resources.Gpu.Hint}"
            TextTrimming="None"
            TextWrapping="Wrap"
          />
          <TextBlock
            Margin="2,6,0,0"
            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
            Text="{Binding Status}"
            TextWrapping="Wrap"
            Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}"
          />
          <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Resources.Gpu.Top}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemTemplate="{StaticResource ResourceRow}" ItemsSource="{Binding Rows}" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GameBoosterViewModel}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Border Style="{StaticResource Panel}">
            <DockPanel>
              <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
              >
                <ui:ProgressRing
                  Width="20"
                  Height="20"
                  Margin="0,0,12,0"
                  IsIndeterminate="True"
                  Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
                />
                <ui:Button
                  Appearance="Primary"
                  Command="{Binding StartCommand}"
                  Content="{l:T Booster.Start}"
                  Icon="{ui:SymbolIcon Games24}"
                  Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                />
                <ui:Button
                  Appearance="Caution"
                  Command="{Binding StopCommand}"
                  Content="{l:T Booster.Stop}"
                  Icon="{ui:SymbolIcon Stop24}"
                  Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}}"
                />
              </StackPanel>
              <ui:SymbolIcon
                Margin="0,0,14,0"
                VerticalAlignment="Top"
                DockPanel.Dock="Left"
                FontSize="28"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Symbol="Games24"
              />
              <StackPanel Margin="0,0,16,0">
                <TextBlock
                  FontSize="16"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Text="{l:T Booster.Title}"
                />
                <TextBlock
                  Margin="0,2,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{l:T Booster.Description}"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock
            Margin="2,8,0,0"
            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
            Text="{Binding Status}"
            TextWrapping="Wrap"
            Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}"
          />
          <DockPanel Margin="0,24,0,10">
            <ui:Button
              Command="{Binding LoadCommand}"
              Content="{l:T Booster.Refresh}"
              DockPanel.Dock="Right"
              Icon="{ui:SymbolIcon ArrowClockwise24}"
            />
            <StackPanel>
              <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{l:T Booster.AppsTitle}"
              />
              <TextBlock
                Style="{StaticResource Muted}"
                Text="{l:T Booster.AppsHint}"
                TextWrapping="Wrap"
              />
            </StackPanel>
          </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                  <DockPanel>
                    <TextBlock
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      Style="{StaticResource Muted}"
                      Text="{Binding MemoryText}"
                    />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}">
                      <StackPanel>
                        <TextBlock
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Name}"
                        />
                        <TextBlock
                          FontSize="11"
                          Style="{StaticResource Muted}"
                          Text="{Binding Path}"
                        />
                      </StackPanel>
                    </CheckBox>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Resources.Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Resources.Subtitle}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox
        Grid.Column="0"
        ItemTemplate="{StaticResource SectionItem}"
        ItemsSource="{Binding Sections}"
        SelectedItem="{Binding Selected}"
        Style="{StaticResource SectionList}"
      />
      <ContentControl Grid.Column="2" Content="{Binding Selected}" Focusable="False" />
    </Grid>
  </Grid>
</UserControl>
