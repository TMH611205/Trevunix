<ui:FluentWindow
  x:Class="Trevunix.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:Trevunix.Views"
  xmlns:vm="clr-namespace:Trevunix.ViewModels"
  Title="Trevunix"
  Width="1180"
  Height="760"
  MinWidth="900"
  MinHeight="560"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
>
  <ui:FluentWindow.Resources>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:OptimizeViewModel}">
      <views:OptimizeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AppsViewModel}">
      <views:AppsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemToolsViewModel}">
      <views:SystemToolsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
      <views:ResourcesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
      <views:CleanupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiskUsageViewModel}">
      <views:DiskUsageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="Trevunix" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/Logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="12,4,8,12">
        <StackPanel DockPanel.Dock="Top" Margin="8,4,0,18" Orientation="Horizontal">
          <Image Width="34" Height="34" Source="pack://application:,,,/Assets/Logo.png" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock
              FontSize="18"
              FontWeight="Bold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Trevunix"
            />
            <TextBlock
              FontSize="11"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
            />
          </StackPanel>
        </StackPanel>

        <ListBox
          x:Name="SettingsNav"
          DockPanel.Dock="Bottom"
          SelectionChanged="OnSettingsSelected"
          Style="{StaticResource NavList}"
        />

        <ListBox
          x:Name="MainNav"
          ItemsSource="{Binding Items}"
          SelectionChanged="OnMainSelected"
          Style="{StaticResource NavList}"
        />
      </DockPanel>

      <Border
        Grid.Column="1"
        Margin="0,0,12,12"
        Background="{DynamicResource LayerFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
      >
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
