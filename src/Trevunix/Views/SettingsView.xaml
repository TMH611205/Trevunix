<UserControl
  x:Class="Trevunix.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Title}" />

      <ui:CardControl Margin="0,24,0,6" Icon="{ui:SymbolIcon LocalLanguage24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T Settings.Language}"
            />
            <TextBlock Style="{StaticResource Muted}" Text="{l:T Settings.Language.Description}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:Button
            Margin="0,0,10,0"
            Appearance="Primary"
            Command="{Binding RestartCommand}"
            Content="{l:T Settings.RestartNow}"
            Visibility="{Binding NeedsRestart, Converter={StaticResource VisibleWhen}}"
          />
          <ComboBox
            MinWidth="180"
            DisplayMemberPath="Name"
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding Language}"
          />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon DarkTheme24}">
        <ui:CardControl.Header>
          <TextBlock
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{l:T Settings.Theme}"
          />
        </ui:CardControl.Header>
        <ComboBox
          MinWidth="180"
          DisplayMemberPath="Name"
          ItemsSource="{Binding Themes}"
          SelectedItem="{Binding Theme}"
        />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ArrowSync24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T Settings.Updates}"
            />
            <TextBlock Style="{StaticResource Muted}" Text="{l:T Settings.Updates.Description}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates}" />
      </ui:CardControl>

      <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Care}" />
      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Power24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T Settings.StartWithWindows}"
            />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{l:T Settings.StartWithWindows.Description}"
              TextWrapping="Wrap"
            />
            <TextBlock
              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
              Text="{Binding StartupError}"
              TextWrapping="Wrap"
              Visibility="{Binding StartupError, Converter={StaticResource VisibleWhen}}"
            />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon History24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T Settings.RestorePoint}"
            />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{l:T Settings.RestorePoint.Description}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding CreateRestorePoint}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon CalendarClock24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T AutoClean.Title}"
            />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{Binding AutoCleanStatus}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox
          MinWidth="180"
          DisplayMemberPath="Name"
          ItemsSource="{Binding Frequencies}"
          SelectedItem="{Binding AutoClean}"
        />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Alert24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T Settings.HealthAlerts}"
            />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{l:T Settings.HealthAlerts.Description}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding HealthAlerts}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ArrowMinimize24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{l:T Settings.CloseToTray}"
            />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{l:T Settings.CloseToTray.Description}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
      </ui:CardControl>

      <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.About}" />
      <Border Style="{StaticResource Panel}">
        <StackPanel Orientation="Horizontal">
          <Image Width="48" Height="48" Source="pack://application:,,,/Assets/Logo.png" />
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock
              FontSize="16"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Trevunix"
            />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Version}" />
            <TextBlock
              Margin="0,2,0,0"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{Binding MadeBy}"
            />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Copyright}" />
            <ui:HyperlinkButton
              Margin="-11,4,0,0"
              Padding="11,4"
              Command="{Binding OpenWebsiteCommand}"
              Content="github.com/TMH611205/Trevunix"
              Icon="{ui:SymbolIcon Open24}"
            />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
