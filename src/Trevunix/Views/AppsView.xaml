<UserControl
  x:Class="Trevunix.Views.AppsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T AppsPage.Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T AppsPage.Subtitle}" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="0,16,0,0">
      <!-- Desktop programs, with deep uninstall -->
      <TabItem DataContext="{Binding Programs}" Header="{l:T AppsPage.Tab.Programs}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock
              Margin="0,0,0,10"
              Style="{StaticResource Muted}"
              Text="{l:T Programs.Hint}"
              TextWrapping="Wrap"
            />
            <DockPanel>
              <ui:Button
                Margin="12,0,0,0"
                Command="{Binding LoadCommand}"
                Content="{l:T Programs.Refresh}"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
              />
              <ui:Button
                Margin="12,0,0,0"
                Command="{Binding ForceUninstallCommand}"
                Content="{l:T Programs.Force.Button}"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon FolderProhibited24}"
              />
              <CheckBox
                Margin="12,0,0,0"
                Content="{l:T Programs.ShowHidden}"
                DockPanel.Dock="Right"
                IsChecked="{Binding ShowHidden}"
              />
              <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Style="{StaticResource Muted}"
                Text="{Binding Summary}"
              />
              <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{l:T Programs.Search}"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
              />
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
              <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Style="{StaticResource Muted}"
                Text="{l:T Programs.SortBy}"
              />
              <ComboBox
                MinWidth="150"
                DisplayMemberPath="Name"
                ItemsSource="{Binding SortChoices}"
                SelectedItem="{Binding SortBy}"
              />
              <ui:Button
                Margin="8,0,0,0"
                Command="{Binding ExportCommand}"
                Content="{l:T Programs.Export}"
                Icon="{ui:SymbolIcon ArrowDownload24}"
              />
              <ui:Button
                Margin="8,0,0,0"
                Appearance="Danger"
                Command="{Binding UninstallCheckedCommand}"
                Content="{Binding UninstallCheckedText}"
                Icon="{ui:SymbolIcon Delete24}"
              />
            </WrapPanel>

            <StackPanel
              Margin="0,10,0,0"
              Orientation="Horizontal"
              Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}"
            >
              <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
              <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Muted}"
                Text="{Binding Status}"
              />
            </StackPanel>
            <ui:InfoBar
              Margin="0,10,0,0"
              IsClosable="False"
              IsOpen="True"
              Message="{Binding Result}"
              Severity="Success"
              Visibility="{Binding Result, Converter={StaticResource VisibleWhen}}"
            />

            <!-- What the uninstalled program left behind -->
            <Border
              Margin="0,10,0,0"
              Style="{StaticResource Panel}"
              Visibility="{Binding HasCurrent, Converter={StaticResource VisibleWhen}}"
            >
              <StackPanel>
                <TextBlock
                  FontSize="16"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Text="{Binding Current.Name}"
                />
                <ui:InfoBar
                  Margin="0,8,0,0"
                  IsClosable="False"
                  IsOpen="True"
                  Message="{l:T Programs.StillInstalled}"
                  Severity="Warning"
                  Visibility="{Binding StillInstalled, Converter={StaticResource VisibleWhen}}"
                />
                <TextBlock
                  Margin="0,8,0,0"
                  Style="{StaticResource Muted}"
                  Text="{l:T Programs.LeftoversHint}"
                  TextWrapping="Wrap"
                />
                <ScrollViewer MaxHeight="260" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding LeftoverItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Margin="0,2" IsChecked="{Binding IsSelected}">
                          <StackPanel>
                            <TextBlock
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Text="{Binding Path}"
                              TextWrapping="Wrap"
                            />
                            <TextBlock
                              FontSize="11"
                              Style="{StaticResource Muted}"
                              Text="{Binding Details}"
                            />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <WrapPanel Margin="0,10,0,0">
                  <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding RemoveLeftoversCommand}"
                    Content="{l:T Programs.RemoveLeftovers}"
                    Icon="{ui:SymbolIcon Delete24}"
                  />
                  <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding ScanLeftoversCommand}"
                    Content="{l:T Programs.ScanAgain}"
                    Icon="{ui:SymbolIcon Search24}"
                  />
                  <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding SelectAllLeftoversCommand}"
                    Content="{l:T Programs.SelectAll}"
                  />
                  <ui:Button Command="{Binding CloseCommand}" Content="{l:T Programs.Done}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                    <DockPanel>
                      <CheckBox
                        MinWidth="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        IsChecked="{Binding IsChecked}"
                      />
                      <Grid Width="32" Height="32" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="AppGeneric24"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                        />
                        <Image Source="{Binding Icon}" />
                      </Grid>
                      <ui:Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Content="{l:T Programs.Uninstall}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Delete24}"
                      />
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                        />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Browser extensions -->
      <TabItem DataContext="{Binding Extensions}" Header="{l:T AppsPage.Tab.Extensions}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock
              Margin="0,0,0,10"
              Style="{StaticResource Muted}"
              Text="{l:T Extensions.Hint}"
              TextWrapping="Wrap"
            />
            <StackPanel Orientation="Horizontal">
              <ui:Button
                Appearance="Primary"
                Command="{Binding LoadCommand}"
                Content="{l:T Extensions.Load}"
                Icon="{ui:SymbolIcon PuzzlePiece24}"
              />
              <ui:ProgressRing
                Width="18"
                Height="18"
                Margin="12,0,0,0"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
              />
              <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Muted}"
                Text="{Binding Status}"
              />
            </StackPanel>
            <ui:InfoBar
              Margin="0,10,0,0"
              IsClosable="False"
              IsOpen="True"
              Message="{Binding Result}"
              Severity="Informational"
              Visibility="{Binding Result, Converter={StaticResource VisibleWhen}}"
            />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}">
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock
                        Margin="0,10,0,6"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                      />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}">
                      <StackPanel Margin="4,0,0,0">
                        <TextBlock
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                        />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" />
                      </StackPanel>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ui:Button
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Appearance="Primary"
            Command="{Binding RemoveSelectedCommand}"
            Content="{Binding RemoveText}"
            Icon="{ui:SymbolIcon Delete24}"
            Visibility="{Binding Loaded, Converter={StaticResource VisibleWhen}}"
          />
        </Grid>
      </TabItem>

      <!-- Startup -->
      <TabItem Header="{l:T AppsPage.Tab.Startup}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <DockPanel>
              <ui:Button
                Command="{Binding LoadStartupCommand}"
                Content="{l:T Startup.Refresh}"
                DockPanel.Dock="Left"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
              />
              <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding StartupSummary}"
                TextAlignment="Right"
              />
            </DockPanel>
            <TextBlock
              Margin="0,10,0,8"
              Style="{StaticResource Muted}"
              Text="{l:T Startup.Hint}"
              TextWrapping="Wrap"
            />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StartupItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="16,12" Style="{StaticResource Panel}">
                    <DockPanel>
                      <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                      >
                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding DataContext.ToggleDelayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Icon="{ui:SymbolIcon Timer24}"
                          ToolTip="{l:T Startup.DelayTip}"
                        >
                          <ui:Button.Style>
                            <Style
                              BasedOn="{StaticResource {x:Type ui:Button}}"
                              TargetType="ui:Button"
                            >
                              <Setter Property="Content" Value="{l:T Startup.Delay}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDelayed}" Value="True">
                                  <Setter Property="Content" Value="{l:T Startup.Undelay}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ui:Button.Style>
                        </ui:Button>
                        <ui:Button
                          Margin="0,0,12,0"
                          Appearance="Transparent"
                          Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Icon="{ui:SymbolIcon FolderOpen24}"
                          ToolTip="{l:T Startup.OpenLocation}"
                        />
                        <ui:ToggleSwitch
                          Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                        />
                      </StackPanel>
                      <Grid
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                      >
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="Apps24"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                        />
                        <Image
                          Source="{Binding Icon}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}}"
                        />
                      </Grid>
                      <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Name}"
                          />
                          <Border
                            Margin="8,0,0,0"
                            Padding="6,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                          >
                            <TextBlock
                              FontSize="11"
                              Style="{StaticResource Muted}"
                              Text="{Binding Impact}"
                            />
                          </Border>
                          <Border
                            Margin="6,0,0,0"
                            Padding="6,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsDelayed, Converter={StaticResource VisibleWhen}}"
                          >
                            <TextBlock
                              FontSize="11"
                              Style="{StaticResource Muted}"
                              Text="{l:T Startup.Delayed}"
                            />
                          </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}">
                          <Run Text="{Binding Publisher, Mode=OneWay}" />
                          <Run Text="·" />
                          <Run Text="{Binding Scope, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                          Margin="0,2,0,0"
                          FontSize="11"
                          Style="{StaticResource Muted}"
                          Text="{Binding Command}"
                        />
                        <TextBlock
                          Margin="0,4,0,0"
                          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding Error}"
                          TextWrapping="Wrap"
                          Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
                        />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Scheduled tasks and services -->
      <TabItem DataContext="{Binding Autoruns}" Header="{l:T AppsPage.Tab.Autoruns}">
        <DockPanel Margin="0,12,0,0">
          <DockPanel Margin="0,0,0,10" DockPanel.Dock="Top">
            <ui:Button
              Command="{Binding RefreshCommand}"
              Content="{l:T Programs.Refresh}"
              DockPanel.Dock="Left"
              Icon="{ui:SymbolIcon ArrowClockwise24}"
            />
            <ui:ProgressRing
              Width="18"
              Height="18"
              Margin="12,0,0,0"
              DockPanel.Dock="Left"
              IsIndeterminate="True"
              Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}"
            />
            <TextBlock
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource Muted}"
              Text="{Binding Status}"
            />
          </DockPanel>
          <TextBlock
            Margin="0,0,0,10"
            DockPanel.Dock="Top"
            Style="{StaticResource Muted}"
            Text="{l:T Autoruns.Hint}"
            TextWrapping="Wrap"
          />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{l:T Autoruns.Tasks}"
              />
              <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="14,8" Style="{StaticResource Panel}">
                      <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsOn}" />
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Name}"
                          />
                          <TextBlock
                            FontSize="11"
                            Style="{StaticResource Muted}"
                            Text="{Binding Detail}"
                            TextTrimming="CharacterEllipsis"
                          />
                          <TextBlock
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
                          />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                Margin="0,12,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{l:T Autoruns.Services}"
              />
              <ItemsControl ItemsSource="{Binding Services}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="14,8" Style="{StaticResource Panel}">
                      <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsOn}" />
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Name}"
                          />
                          <TextBlock
                            FontSize="11"
                            Style="{StaticResource Muted}"
                            Text="{Binding Detail}"
                            TextTrimming="CharacterEllipsis"
                          />
                          <TextBlock
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
                          />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Preinstalled apps -->
      <TabItem Header="{l:T AppsPage.Tab.Store}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock
              Margin="0,0,0,10"
              Style="{StaticResource Muted}"
              Text="{l:T Store.Hint}"
              TextWrapping="Wrap"
            />
            <ui:Button
              HorizontalAlignment="Left"
              Appearance="Primary"
              Command="{Binding LoadStoreCommand}"
              Content="{l:T Store.Load}"
              Icon="{ui:SymbolIcon AppsList24}"
              Visibility="{Binding StoreLoaded, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
            />
            <DockPanel Visibility="{Binding StoreLoaded, Converter={StaticResource VisibleWhen}}">
              <CheckBox
                Margin="12,0,0,0"
                Content="{l:T Store.OnlySuggested}"
                DockPanel.Dock="Right"
                IsChecked="{Binding OnlySuggested}"
              />
              <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{l:T Store.Search}"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
              />
            </DockPanel>
            <ui:InfoBar
              Margin="0,10,0,0"
              IsClosable="False"
              IsOpen="True"
              Message="{Binding StoreResult}"
              Severity="Informational"
              Visibility="{Binding StoreResult, Converter={StaticResource VisibleWhen}}"
            />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StoreView}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                    <DockPanel>
                      <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        IsChecked="{Binding IsSelected}"
                      />
                      <Grid
                        Width="32"
                        Height="32"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                      >
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="Apps24"
                          Visibility="{Binding Logo, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                        />
                        <Image
                          Source="{Binding Logo}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Visibility="{Binding Logo, Converter={StaticResource VisibleWhen}}"
                        />
                      </Grid>
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding DisplayName}"
                          />
                          <Border
                            Margin="8,0,0,0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{Binding Suggested, Converter={StaticResource VisibleWhen}}"
                          >
                            <TextBlock
                              FontSize="11"
                              Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                              Text="{l:T Store.Suggested}"
                            />
                          </Border>
                        </StackPanel>
                        <TextBlock
                          Margin="0,2,0,0"
                          FontSize="11"
                          Style="{StaticResource Muted}"
                          Text="{Binding Details}"
                        />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Style="{StaticResource Panel}"
            Visibility="{Binding StoreLoaded, Converter={StaticResource VisibleWhen}}"
          >
            <DockPanel>
              <ui:Button
                Appearance="Danger"
                Command="{Binding RemoveSelectedCommand}"
                Content="{Binding RemoveText}"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon Delete24}"
              />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox
                  Content="{l:T Store.AlsoNewUsers}"
                  IsChecked="{Binding AlsoForNewUsers}"
                />
                <ui:ProgressRing
                  Width="18"
                  Height="18"
                  Margin="16,0,8,0"
                  IsIndeterminate="True"
                  Visibility="{Binding StoreBusy, Converter={StaticResource VisibleWhen}}"
                />
                <TextBlock
                  VerticalAlignment="Center"
                  Style="{StaticResource Muted}"
                  Text="{Binding StoreStatus}"
                />
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
