<UserControl
  x:Class="Trevunix.Views.AppsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T AppsPage.Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T AppsPage.Subtitle}" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="0,16,0,0">
      <!-- Startup -->
      <TabItem Header="{l:T AppsPage.Tab.Startup}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <DockPanel>
              <ui:Button
                Command="{Binding LoadStartupCommand}"
                Content="{l:T Startup.Refresh}"
                DockPanel.Dock="Left"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
              />
              <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding StartupSummary}"
                TextAlignment="Right"
              />
            </DockPanel>
            <TextBlock
              Margin="0,10,0,8"
              Style="{StaticResource Muted}"
              Text="{l:T Startup.Hint}"
              TextWrapping="Wrap"
            />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StartupItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="16,12" Style="{StaticResource Panel}">
                    <DockPanel>
                      <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                      >
                        <ui:Button
                          Margin="0,0,12,0"
                          Appearance="Transparent"
                          Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          Icon="{ui:SymbolIcon FolderOpen24}"
                          ToolTip="{l:T Startup.OpenLocation}"
                        />
                        <ui:ToggleSwitch
                          Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                        />
                      </StackPanel>
                      <Grid
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                      >
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="Apps24"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                        />
                        <Image
                          Source="{Binding Icon}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}}"
                        />
                      </Grid>
                      <StackPanel Margin="0,0,16,0">
                        <TextBlock
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Name}"
                        />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}">
                          <Run Text="{Binding Publisher, Mode=OneWay}" />
                          <Run Text="·" />
                          <Run Text="{Binding Scope, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                          Margin="0,2,0,0"
                          FontSize="11"
                          Style="{StaticResource Muted}"
                          Text="{Binding Command}"
                        />
                        <TextBlock
                          Margin="0,4,0,0"
                          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding Error}"
                          TextWrapping="Wrap"
                          Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
                        />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Preinstalled apps -->
      <TabItem Header="{l:T AppsPage.Tab.Store}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock
              Margin="0,0,0,10"
              Style="{StaticResource Muted}"
              Text="{l:T Store.Hint}"
              TextWrapping="Wrap"
            />
            <ui:Button
              HorizontalAlignment="Left"
              Appearance="Primary"
              Command="{Binding LoadStoreCommand}"
              Content="{l:T Store.Load}"
              Icon="{ui:SymbolIcon AppsList24}"
              Visibility="{Binding StoreLoaded, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
            />
            <DockPanel Visibility="{Binding StoreLoaded, Converter={StaticResource VisibleWhen}}">
              <CheckBox
                Margin="12,0,0,0"
                Content="{l:T Store.OnlySuggested}"
                DockPanel.Dock="Right"
                IsChecked="{Binding OnlySuggested}"
              />
              <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{l:T Store.Search}"
                Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
              />
            </DockPanel>
            <ui:InfoBar
              Margin="0,10,0,0"
              IsClosable="False"
              IsOpen="True"
              Message="{Binding StoreResult}"
              Severity="Informational"
              Visibility="{Binding StoreResult, Converter={StaticResource VisibleWhen}}"
            />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StoreView}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                    <DockPanel>
                      <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        IsChecked="{Binding IsSelected}"
                      />
                      <Grid
                        Width="32"
                        Height="32"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                      >
                        <ui:SymbolIcon
                          FontSize="24"
                          Symbol="Apps24"
                          Visibility="{Binding Logo, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                        />
                        <Image
                          Source="{Binding Logo}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Visibility="{Binding Logo, Converter={StaticResource VisibleWhen}}"
                        />
                      </Grid>
                      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding DisplayName}"
                          />
                          <Border
                            Margin="8,0,0,0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{Binding Suggested, Converter={StaticResource VisibleWhen}}"
                          >
                            <TextBlock
                              FontSize="11"
                              Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                              Text="{l:T Store.Suggested}"
                            />
                          </Border>
                        </StackPanel>
                        <TextBlock
                          Margin="0,2,0,0"
                          FontSize="11"
                          Style="{StaticResource Muted}"
                          Text="{Binding Details}"
                        />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Style="{StaticResource Panel}"
            Visibility="{Binding StoreLoaded, Converter={StaticResource VisibleWhen}}"
          >
            <DockPanel>
              <ui:Button
                Appearance="Danger"
                Command="{Binding RemoveSelectedCommand}"
                Content="{Binding RemoveText}"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon Delete24}"
              />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox
                  Content="{l:T Store.AlsoNewUsers}"
                  IsChecked="{Binding AlsoForNewUsers}"
                />
                <ui:ProgressRing
                  Width="18"
                  Height="18"
                  Margin="16,0,8,0"
                  IsIndeterminate="True"
                  Visibility="{Binding StoreBusy, Converter={StaticResource VisibleWhen}}"
                />
                <TextBlock
                  VerticalAlignment="Center"
                  Style="{StaticResource Muted}"
                  Text="{Binding StoreStatus}"
                />
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
