<UserControl
  x:Class="Trevunix.Views.SystemToolsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:Trevunix.ViewModels"
  Loaded="OnLoaded"
  Unloaded="OnUnloaded"
>
  <UserControl.Resources>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- Speed test: one big live number, then the four results. -->
    <Style x:Key="ResultValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <DataTemplate DataType="{x:Type vm:SpeedTestViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Padding="24" Style="{StaticResource Panel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock
                  FontSize="14"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                  Text="{Binding PhaseText}"
                />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                  <TextBlock
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding LiveText}"
                  />
                  <TextBlock
                    Margin="10,0,0,14"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Style="{StaticResource Muted}"
                    Text="Mbps"
                  />
                </StackPanel>
                <ProgressBar
                  Height="8"
                  Margin="0,8,0,0"
                  Maximum="100"
                  Minimum="0"
                  Value="{Binding Progress, Mode=OneWay}"
                />
                <TextBlock
                  Margin="0,10,0,0"
                  Style="{StaticResource Muted}"
                  Text="{Binding ServerText}"
                  TextTrimming="CharacterEllipsis"
                />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <ui:Button
                  MinWidth="150"
                  Padding="16,10"
                  HorizontalAlignment="Stretch"
                  Appearance="Primary"
                  Command="{Binding StartCommand}"
                  Content="{l:T Speed.Start}"
                  FontSize="15"
                  Icon="{ui:SymbolIcon Play24}"
                />
                <ui:Button
                  Margin="0,8,0,0"
                  HorizontalAlignment="Stretch"
                  Command="{Binding CancelCommand}"
                  Content="{l:T Speed.Cancel}"
                  Icon="{ui:SymbolIcon Stop24}"
                />
              </StackPanel>
            </Grid>
          </Border>

          <UniformGrid Margin="0,12,0,0" Columns="4">
            <Border Margin="0,0,8,0" Style="{StaticResource Panel}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon
                    FontSize="18"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="ArrowDown24"
                  />
                  <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Muted}"
                    Text="{l:T Speed.Download}"
                  />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultValue}" Text="{Binding Download}" />
                <TextBlock FontSize="11" Style="{StaticResource Muted}" Text="Mbps" />
              </StackPanel>
            </Border>
            <Border Margin="4,0,4,0" Style="{StaticResource Panel}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon
                    FontSize="18"
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Symbol="ArrowUp24"
                  />
                  <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Muted}"
                    Text="{l:T Speed.Upload}"
                  />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultValue}" Text="{Binding Upload}" />
                <TextBlock FontSize="11" Style="{StaticResource Muted}" Text="Mbps" />
              </StackPanel>
            </Border>
            <Border Margin="4,0,4,0" Style="{StaticResource Panel}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon FontSize="18" Symbol="Timer24" />
                  <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Muted}"
                    Text="{l:T Speed.Ping}"
                  />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultValue}" Text="{Binding Ping}" />
              </StackPanel>
            </Border>
            <Border Margin="8,0,0,0" Style="{StaticResource Panel}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon FontSize="18" Symbol="DataLine24" />
                  <TextBlock
                    Margin="6,0,0,0"
                    Style="{StaticResource Muted}"
                    Text="{l:T Speed.Jitter}"
                  />
                </StackPanel>
                <TextBlock Style="{StaticResource ResultValue}" Text="{Binding Jitter}" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <TextBlock
            Margin="2,10,0,0"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Text="{Binding Error}"
            TextWrapping="Wrap"
            Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
          />
          <ui:InfoBar
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="True"
            Message="{l:T Speed.Hint}"
            Severity="Informational"
          />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
      <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <UniformGrid Columns="2">
            <Border Margin="0,0,6,12" Style="{StaticResource Panel}">
              <StackPanel>
                <DockPanel>
                  <TextBlock
                    DockPanel.Dock="Right"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding CpuText}"
                  />
                  <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{l:T Monitor.Cpu}"
                  />
                </DockPanel>
                <Border
                  Height="110"
                  Margin="0,12,0,4"
                  Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                  ClipToBounds="True"
                  CornerRadius="6"
                >
                  <Viewbox Stretch="Fill">
                    <Canvas Width="300" Height="80">
                      <Polyline
                        Points="{Binding CpuHistory}"
                        Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="1.5"
                      />
                    </Canvas>
                  </Viewbox>
                </Border>
                <TextBlock
                  FontSize="11"
                  Style="{StaticResource Muted}"
                  Text="{l:T Monitor.History}"
                />
              </StackPanel>
            </Border>
            <Border Margin="6,0,0,12" Style="{StaticResource Panel}">
              <StackPanel>
                <DockPanel>
                  <TextBlock
                    DockPanel.Dock="Right"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding MemoryText}"
                  />
                  <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{l:T Monitor.Memory}"
                  />
                </DockPanel>
                <Border
                  Height="110"
                  Margin="0,12,0,4"
                  Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                  ClipToBounds="True"
                  CornerRadius="6"
                >
                  <Viewbox Stretch="Fill">
                    <Canvas Width="300" Height="80">
                      <Polyline
                        Points="{Binding MemoryHistory}"
                        Stroke="{DynamicResource SystemFillColorSuccessBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="1.5"
                      />
                    </Canvas>
                  </Viewbox>
                </Border>
                <TextBlock
                  FontSize="11"
                  Style="{StaticResource Muted}"
                  Text="{l:T Monitor.History}"
                />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{l:T Monitor.Network}"
              />
              <TextBlock
                Margin="0,12,0,0"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding NetworkText}"
              />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
      <DockPanel Margin="0">
        <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ui:Button
              Margin="8,0,0,0"
              Command="{Binding OpenLocationCommand}"
              CommandParameter="{Binding Selected}"
              Content="{l:T Processes.OpenLocation}"
              Icon="{ui:SymbolIcon FolderOpen24}"
            />
            <ui:Button
              Margin="8,0,0,0"
              Appearance="Danger"
              Command="{Binding EndCommand}"
              CommandParameter="{Binding Selected}"
              Content="{l:T Processes.End}"
              Icon="{ui:SymbolIcon Dismiss24}"
            />
          </StackPanel>
          <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Right"
            Style="{StaticResource Muted}"
            Text="{Binding Count}"
          />
          <ui:TextBox
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="{l:T Processes.Search}"
            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
          />
        </DockPanel>
        <ListView
          ItemsSource="{Binding View}"
          SelectedItem="{Binding Selected}"
          SelectionMode="Single"
        >
          <ListView.View>
            <GridView>
              <GridViewColumn Width="260" Header="{l:T Processes.Col.Name}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Grid Width="20" Height="20" Margin="0,0,8,0">
                        <ui:SymbolIcon
                          FontSize="16"
                          Symbol="Apps24"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                        />
                        <Image
                          Source="{Binding Icon}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}}"
                        />
                      </Grid>
                      <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn
                Width="80"
                DisplayMemberBinding="{Binding Id}"
                Header="{l:T Processes.Col.Id}"
              />
              <GridViewColumn
                Width="80"
                DisplayMemberBinding="{Binding Cpu}"
                Header="{l:T Processes.Col.Cpu}"
              />
              <GridViewColumn Width="110" Header="{l:T Processes.Col.Memory}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Memory, Converter={StaticResource Bytes}}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn
                Width="420"
                DisplayMemberBinding="{Binding Path}"
                Header="{l:T Processes.Col.Path}"
              />
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RepairViewModel}">
      <Grid Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="230" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <TextBlock
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Style="{StaticResource Muted}"
            Text="{l:T Repair.Hint}"
            TextWrapping="Wrap"
          />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                    <DockPanel>
                      <ui:Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Content="{l:T Repair.Run}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Play24}"
                      />
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Name}"
                          />
                          <Border
                            Style="{StaticResource Badge}"
                            Visibility="{Binding LongRunning, Converter={StaticResource VisibleWhen}}"
                          >
                            <TextBlock
                              FontSize="11"
                              Style="{StaticResource Muted}"
                              Text="{l:T Repair.LongRunning}"
                            />
                          </Border>
                        </StackPanel>
                        <TextBlock
                          Margin="0,2,0,0"
                          Style="{StaticResource Muted}"
                          Text="{Binding Description}"
                          TextTrimming="None"
                          TextWrapping="Wrap"
                        />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Row="2">
          <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <ui:Button
              Command="{Binding CancelCommand}"
              Content="{l:T Repair.Cancel}"
              DockPanel.Dock="Right"
              Icon="{ui:SymbolIcon Stop24}"
            />
            <ui:ProgressRing
              Width="18"
              Height="18"
              Margin="0,0,8,0"
              DockPanel.Dock="Left"
              IsIndeterminate="True"
              Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}"
            />
            <TextBlock
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{Binding Status}"
              TextTrimming="CharacterEllipsis"
            />
          </DockPanel>
          <Border Padding="10" Background="#FF101418" CornerRadius="8">
            <ListBox
              Loaded="OnOutputLoaded"
              Background="Transparent"
              BorderThickness="0"
              FontFamily="Cascadia Mono, Consolas"
              FontSize="12"
              Foreground="#FFD6DEE6"
              ItemsSource="{Binding Output}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
            >
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <TextBlock Foreground="#FFD6DEE6" Text="{Binding}" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Border>
        </DockPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DnsViewModel}">
      <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock
            Style="{StaticResource Muted}"
            Text="{l:T Dns.Hint}"
            TextTrimming="None"
            TextWrapping="Wrap"
          />
          <Border Margin="0,12,0,0" Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{l:T Dns.Current}"
              />
              <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,2" Style="{StaticResource Muted}" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <DockPanel Margin="0,12,0,8">
            <ui:Button
              Command="{Binding TestSpeedCommand}"
              Content="{l:T Dns.TestSpeed}"
              DockPanel.Dock="Left"
              Icon="{ui:SymbolIcon TopSpeed24}"
            />
            <ui:ProgressRing
              Width="18"
              Height="18"
              Margin="12,0,0,0"
              DockPanel.Dock="Left"
              IsIndeterminate="True"
              Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
            />
            <TextBlock
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{Binding Status}"
            />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="14,10" Style="{StaticResource Panel}">
                  <DockPanel>
                    <ui:Button
                      Margin="12,0,0,0"
                      Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      Content="{l:T Dns.Apply}"
                      DockPanel.Dock="Right"
                    />
                    <TextBlock
                      MinWidth="90"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      Style="{StaticResource Muted}"
                      Text="{Binding Latency}"
                      TextAlignment="Right"
                    />
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Name}"
                        />
                        <Border
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          BorderThickness="0"
                          Style="{StaticResource Badge}"
                          Visibility="{Binding InUse, Converter={StaticResource VisibleWhen}}"
                        >
                          <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Text="{l:T Dns.InUse}"
                          />
                        </Border>
                      </StackPanel>
                      <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Style="{StaticResource Muted}"
                        Text="{Binding Servers}"
                      />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DrivesViewModel}">
      <StackPanel Margin="0">
        <StackPanel Orientation="Horizontal">
          <ui:Button
            Appearance="Primary"
            Command="{Binding LoadCommand}"
            Content="{l:T Drives.Load}"
            Icon="{ui:SymbolIcon HardDrive20}"
          />
          <ui:ProgressRing
            Width="18"
            Height="18"
            Margin="12,0,0,0"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
          />
          <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource Muted}"
            Text="{Binding Status}"
          />
        </StackPanel>
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Disks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Style="{StaticResource Panel}">
                <StackPanel>
                  <DockPanel>
                    <Border
                      Padding="8,2"
                      CornerRadius="4"
                      DockPanel.Dock="Right"
                      Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    >
                      <TextBlock FontWeight="SemiBold" Text="{Binding HealthText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter
                              Property="Foreground"
                              Value="{DynamicResource SystemFillColorSuccessBrush}"
                            />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBad}" Value="True">
                                <Setter
                                  Property="Foreground"
                                  Value="{DynamicResource SystemFillColorCriticalBrush}"
                                />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon FontSize="22" Symbol="HardDrive20" />
                      <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}"
                      />
                    </StackPanel>
                  </DockPanel>
                  <UniformGrid Margin="0,14,0,0" Columns="4">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Drives.Temperature}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Temperature}"
                      />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Drives.Wear}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Wear}"
                      />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Drives.PowerOn}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding PowerOn}"
                      />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Drives.Errors}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Errors}"
                      />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BatteryViewModel}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:Button
            Appearance="Primary"
            Command="{Binding LoadCommand}"
            Content="{l:T Battery.Load}"
            Icon="{ui:SymbolIcon ArrowClockwise24}"
          />
          <ui:ProgressRing
            Width="18"
            Height="18"
            Margin="12,0,0,0"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
          />
          <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource Muted}"
            Text="{Binding Status}"
          />
        </StackPanel>
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Batteries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Style="{StaticResource Panel}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="22" Symbol="Battery524" />
                    <TextBlock
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      Text="{Binding Title}"
                    />
                  </StackPanel>
                  <DockPanel Margin="0,16,0,0">
                    <TextBlock
                      MinWidth="96"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Left"
                      FontSize="36"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      Text="{Binding Health}"
                    />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Battery.Health}" />
                      <ProgressBar
                        Margin="0,8"
                        Style="{StaticResource UsageBar}"
                        Value="{Binding HealthValue, Mode=OneWay}"
                      />
                      <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding HealthHint}"
                        TextWrapping="Wrap"
                      >
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter
                              Property="Foreground"
                              Value="{DynamicResource SystemFillColorSuccessBrush}"
                            />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsWorn}" Value="True">
                                <Setter
                                  Property="Foreground"
                                  Value="{DynamicResource SystemFillColorCautionBrush}"
                                />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                  <UniformGrid Margin="0,16,0,0" Columns="3">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Battery.Capacity}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Capacity}"
                      />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Battery.Cycles}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Cycles}"
                      />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Muted}" Text="{l:T Battery.Charge}" />
                      <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Charge}"
                      />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T ToolsPage.Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T ToolsPage.Subtitle}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox
        Grid.Column="0"
        ItemTemplate="{StaticResource SectionItem}"
        ItemsSource="{Binding Sections}"
        SelectedItem="{Binding Selected}"
        Style="{StaticResource SectionList}"
      />
      <DockPanel Grid.Column="2">
        <StackPanel Margin="0,0,0,14" DockPanel.Dock="Top">
          <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding Selected.Title}"
          />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding Selected.Description}" />
        </StackPanel>
        <ContentControl Content="{Binding Selected}" Focusable="False" />
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
