<UserControl
  x:Class="Trevunix.Views.OptimizeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:Trevunix.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <Grid Margin="32,28,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="{Binding Summary}"
        />
        <StackPanel Orientation="Horizontal">
          <ui:Button
            Margin="0,0,8,0"
            Appearance="Primary"
            Command="{Binding ApplyRecommendedCommand}"
            Content="{l:T Optimize.ApplyRecommended}"
            Visibility="{Binding HasRecommended, Converter={StaticResource VisibleWhen}}"
            Icon="{ui:SymbolIcon Sparkle24}"
          />
          <ui:Button
            Command="{Binding UndoAllCommand}"
            Content="{l:T Optimize.UndoAll}"
            Icon="{ui:SymbolIcon ArrowUndo24}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ExportProfileCommand}"
            Content="{l:T Optimize.Profile.Export}"
            Icon="{ui:SymbolIcon ArrowExport24}"
          />
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding ImportProfileCommand}"
            Content="{l:T Optimize.Profile.Import}"
            Icon="{ui:SymbolIcon ArrowImport24}"
          />
          <ui:ProgressRing
            Width="20"
            Height="20"
            Margin="12,0,0,0"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
          />
          <TextBlock
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource Muted}"
            Text="{Binding Notice}"
          />
        </StackPanel>
      </DockPanel>

      <ui:InfoBar
        Margin="0,12,0,0"
        IsClosable="False"
        IsOpen="True"
        Message="{l:T Optimize.PendingExplorer}"
        Severity="Informational"
        Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource VisibleWhen}}"
      >
        <ui:InfoBar.Content>
          <ui:Button
            Command="{Binding RestartExplorerCommand}"
            Content="{l:T Optimize.RestartExplorer}"
            Icon="{ui:SymbolIcon ArrowClockwise24}"
          />
        </ui:InfoBar.Content>
      </ui:InfoBar>
      <ui:InfoBar
        Margin="0,8,0,0"
        IsClosable="False"
        IsOpen="True"
        Message="{l:T Optimize.PendingReboot}"
        Severity="Warning"
        Visibility="{Binding NeedsReboot, Converter={StaticResource VisibleWhen}}"
      />
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sections -->
      <ListBox
        Grid.Column="0"
        ItemsSource="{Binding Groups}"
        SelectedItem="{Binding SelectedGroup}"
        Style="{StaticResource SectionList}"
      >
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                FontSize="12"
                Opacity="0.75"
                Text="{Binding Count}"
              />
              <ui:SymbolIcon FontSize="18" Symbol="{Binding Icon}" />
              <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis"
              />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Tweaks of the selected section -->
      <DockPanel Grid.Column="2">
        <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top">
          <TextBlock
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding SelectedGroup.Name}"
          />
          <TextBlock
            Margin="0,2,0,8"
            Style="{StaticResource Muted}"
            Text="{Binding SelectedGroup.Description}"
            TextWrapping="Wrap"
          />
          <StackPanel Orientation="Horizontal">
            <ui:Button
              Margin="0,0,8,0"
              Command="{Binding ApplyGroupCommand}"
              CommandParameter="{Binding SelectedGroup}"
              Content="{l:T Optimize.ApplyGroup}"
              Icon="{ui:SymbolIcon Checkmark24}"
            />
            <ui:Button
              Appearance="Transparent"
              Command="{Binding UndoGroupCommand}"
              CommandParameter="{Binding SelectedGroup}"
              Content="{l:T Optimize.UndoGroup}"
              Icon="{ui:SymbolIcon ArrowUndo24}"
            />
          </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SelectedGroup.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="16,12" Style="{StaticResource Panel}">
                  <DockPanel>
                    <StackPanel
                      DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                    >
                      <ui:ProgressRing
                        Width="18"
                        Height="18"
                        Margin="0,0,10,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"
                      />
                      <ui:ToggleSwitch
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        IsChecked="{Binding IsOn, Mode=OneWay}"
                      />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                      <WrapPanel>
                        <TextBlock
                          Margin="0,0,8,0"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Name}"
                        />
                        <Border
                          Margin="0,0,6,0"
                          Padding="6,1"
                          VerticalAlignment="Center"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          CornerRadius="4"
                          Visibility="{Binding Recommended, Converter={StaticResource VisibleWhen}}"
                        >
                          <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Text="{l:T Optimize.Recommended}"
                          />
                        </Border>
                        <Border
                          Margin="0,0,6,0"
                          Padding="6,1"
                          VerticalAlignment="Center"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Visibility="{Binding AfterText, Converter={StaticResource VisibleWhen}}"
                        >
                          <TextBlock
                            FontSize="11"
                            Style="{StaticResource Muted}"
                            Text="{Binding AfterText}"
                          />
                        </Border>
                        <Border
                          Padding="6,1"
                          VerticalAlignment="Center"
                          Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                          CornerRadius="4"
                          Visibility="{Binding IsPartial, Converter={StaticResource VisibleWhen}}"
                        >
                          <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{l:T Optimize.Partial}"
                          />
                        </Border>
                      </WrapPanel>
                      <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource Muted}"
                        Text="{Binding Description}"
                        TextTrimming="None"
                        TextWrapping="Wrap"
                      />
                      <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding Error}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}"
                      />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
